
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>VECIA Juristas | Asesoramiento, consultoría y mucho + Derecho</title>

<meta name="description" content="VECIA Juristas. Asesoramiento, consultoría y mucho más Derecho.">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
:root {
    --verde: #102b24;
    --verde-claro: #1b4035;
    --marfil: #f3ecdf;
    --burdeos: #571b24;
    --dorado: #c6a15b;
    --texto: #241b18;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    scroll-behavior: smooth;
}

body {
    background: var(--marfil);
    color: var(--texto);
    font-family: 'DM Sans', sans-serif;
}

a {
    color: inherit;
    text-decoration: none;
}

/* CABECERA */

header {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 10;
    padding: 25px 6%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 25px;
    color: var(--marfil);
}

.logo {
    font-family: 'Cormorant Garamond', serif;
    font-size: 37px;
    line-height: .8;
    font-weight: 700;
    letter-spacing: 1px;
    white-space: nowrap;
}

.logo span {
    display: block;
    color: var(--dorado);
    font-family: 'DM Sans', sans-serif;
    font-size: 11px;
    letter-spacing: 8px;
    margin-top: 10px;
    padding-left: 5px;
}

nav {
    display: flex;
    align-items: center;
    gap: 30px;
    font-size: 13px;
}

nav a {
    transition: color .3s;
}

nav a:hover {
    color: var(--dorado);
}

.lema-header {
    color: var(--marfil);
    font-family: 'Cormorant Garamond', serif;
    font-size: 19px;
    font-style: italic;
    border-bottom: 1px solid var(--dorado);
    padding-bottom: 5px;
    white-space: nowrap;
}

/* PORTADA */

.hero {
    min-height: 690px;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    background:
        linear-gradient(90deg, rgba(10,29,24,.98) 0%,
        rgba(10,29,24,.92) 42%,
        rgba(10,29,24,.25) 75%,
        rgba(10,29,24,.05) 100%),
        url('tu-fotografia.jpg') right center / auto 100% no-repeat,
        var(--verde);
    padding: 140px 8% 70px;
}

.hero::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 95px;
    height: 100%;
    background: linear-gradient(135deg, var(--burdeos), transparent 75%);
    opacity: .8;
    clip-path: polygon(0 0, 100% 0, 0 58%);
}

.hero-contenido {
    position: relative;
    z-index: 2;
    max-width: 650px;
    color: var(--marfil);
}

.hero h1 {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(90px, 13vw, 170px);
    line-height: .75;
    font-weight: 500;
    letter-spacing: -5px;
}

.hero-subtitulo {
    color: var(--dorado);
    font-size: clamp(20px, 3vw, 31px);
    letter-spacing: 13px;
    margin: 25px 0 20px 8px;
}

.linea-dorada {
    width: 390px;
    max-width: 90%;
    height: 2px;
    background: var(--dorado);
    margin-bottom: 23px;
}

.hero-frase {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(30px, 4vw, 45px);
    font-style: italic;
    line-height: 1.05;
    max-width: 560px;
}

.hero-frase strong {
    color: var(--dorado);
    font-weight: 600;
}

.boton {
    display: inline-block;
    border: 1px solid var(--dorado);
    color: var(--marfil);
    padding: 14px 27px;
    margin-top: 30px;
    font-size: 14px;
    transition: .3s;
}

.boton:hover {
    background: var(--dorado);
    color: var(--verde);
}

.hero-lateral {
    position: absolute;
    right: 5%;
    top: 48%;
    transform: translateY(-50%);
    color: var(--texto);
    font-family: 'Cormorant Garamond', serif;
    font-size: 25px;
    font-style: italic;
    line-height: 1.2;
    z-index: 2;
}

/* PRESENTACIÓN */

.introduccion {
    padding: 85px 9%;
    text-align: center;
    background: var(--marfil);
}

.etiqueta {
    color: var(--burdeos);
    text-transform: uppercase;
    letter-spacing: 4px;
    font-size: 11px;
    font-weight: 700;
}

.introduccion h2 {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(38px, 5vw, 57px);
    font-weight: 500;
    margin: 17px auto;
    max-width: 800px;
    line-height: 1;
}

.introduccion p {
    max-width: 690px;
    margin: 0 auto;
    line-height: 1.8;
    font-size: 15px;
}

/* SECCIONES */

.secciones {
    display: grid;
    grid-template-columns: repeat(3, 1fr) 1.05fr;
    background: var(--marfil);
}

.tarjeta {
    min-height: 390px;
    border-top: 1px solid rgba(120,90,50,.35);
    border-right: 1px solid rgba(120,90,50,.35);
}

.tarjeta-imagen {
    height: 170px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background:
        linear-gradient(135deg, rgba(16,43,36,.2), rgba(87,27,36,.25)),
        var(--verde-claro);
    color: var(--dorado);
    font-family: 'Cormorant Garamond', serif;
    font-size: 64px;
}

.tarjeta:nth-child(2) .tarjeta-imagen {
    background: linear-gradient(135deg, #302b24, #796448);
}

.tarjeta:nth-child(3) .tarjeta-imagen {
    background: linear-gradient(135deg, #642c32, #291c1d);
}

.tarjeta-contenido {
    padding: 27px 30px 35px;
}

.tarjeta h3 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 31px;
    line-height: 1;
    font-weight: 600;
    margin-bottom: 17px;
}

.tarjeta p {
    font-size: 14px;
    line-height: 1.65;
    margin-bottom: 22px;
}

.enlace {
    font-size: 13px;
    font-weight: 700;
    border-bottom: 1px solid var(--dorado);
    padding-bottom: 5px;
}

.enlace:hover {
    color: var(--burdeos);
}

/* CONTACTO */

.contacto {
    background: var(--burdeos);
    color: var(--marfil);
    padding: 35px 30px;
    position: relative;
    overflow: hidden;
}

.contacto::after {
    content: "V";
    position: absolute;
    right: -5px;
    bottom: -75px;
    font-family: 'Cormorant Garamond', serif;
    font-size: 270px;
    color: rgba(255,255,255,.06);
    pointer-events: none;
}

.contacto h3 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 39px;
    font-weight: 500;
    margin-bottom: 12px;
}

.contacto .linea-dorada {
    width: 65px;
    margin-bottom: 22px;
}

.contacto p {
    font-size: 14px;
    line-height: 1.7;
    margin-bottom: 20px;
}

.contacto .boton {
    position: relative;
    z-index: 2;
}

/* PIE */

footer {
    background: var(--verde);
    color: var(--marfil);
    padding: 30px 6%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    font-size: 11px;
    letter-spacing: 3px;
}

footer span {
    color: var(--dorado);
}

/* ADAPTACIÓN A MÓVILES */

@media (max-width: 900px) {
    header {
        padding: 20px 5%;
        flex-wrap: wrap;
    }

    nav {
        order: 3;
        width: 100%;
        justify-content: space-between;
        gap: 12px;
        font-size: 11px;
    }

    .lema-header {
        font-size: 15px;
    }

    .hero {
        min-height: 650px;
        background-position: center, 65% center, center;
        background-size: cover, auto 75%, cover;
        align-items: flex-end;
        padding: 180px 7% 65px;
    }

    .hero-contenido {
        background: linear-gradient(90deg, rgba(10,29,24,.9), rgba(10,29,24,.2));
        padding: 20px;
    }

    .hero-lateral {
        display: none;
    }

    .secciones {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 560px) {
    header {
        padding: 17px 6%;
    }

    .logo {
        font-size: 30px;
    }

    .lema-header {
        font-size: 13px;
    }

    nav {
        overflow-x: auto;
        white-space: nowrap;
        justify-content: flex-start;
        gap: 22px;
        padding: 12px 0;
    }

    .hero {
        min-height: 680px;
        background-position: center, 62% top, center;
        background-size: cover, auto 67%, cover;
        padding: 370px 5% 45px;
    }

    .hero-contenido {
        padding: 17px;
        background: rgba(10,29,24,.88);
    }

    .hero h1 {
        font-size: 85px;
    }

    .hero-subtitulo {
        font-size: 18px;
        letter-spacing: 9px;
    }

    .hero-frase {
        font-size: 31px;
    }

    .introduccion {
        padding: 65px 8%;
    }

    .secciones {
        grid-template-columns: 1fr;
    }

    .tarjeta {
        min-height: auto;
    }

    .tarjeta-imagen {
        height: 145px;
    }

    .contacto {
        padding: 40px 30px;
    }

    footer {
        flex-direction: column;
        text-align: center;
        line-height: 1.8;
        letter-spacing: 2px;
    }
}
</style>
</head>

